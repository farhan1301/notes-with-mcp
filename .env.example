# Public values from YOUR dedicated Supabase project. Rebuild after changing.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Optional: enable the Google button AFTER configuring Google in Supabase Auth.
VITE_ENABLE_GOOGLE_AUTH=false
# Never put a Supabase secret/service-role key or agent key in VITE_* variables.
